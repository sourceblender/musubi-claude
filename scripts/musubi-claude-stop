#!/usr/bin/env python3
"""Claude Code Stop adapter: parse the last completed primary turn and shadow-enqueue it.

Mirrors the musubi-codex adapter's discipline against the shared host-neutral
contract. THE STOP EVENT IS AUTHORITATIVE for the three facts that decide what is
stored: `session_id`, `prompt_id`, and `last_assistant_message`. The transcript is
consulted only to look up that exact prompt's user text and context; it never
selects a turn and never reconstructs assistant prose.

This adapter previously derived everything from the transcript, on the belief that
Stop supplied only session_id + transcript_path. That belief was never checked. A
shape probe over nine consecutive real Stop events found `last_assistant_message`
non-empty on 9/9 and `prompt_id` present on 9/9. Deriving what the event already
states cost 5,938 declined turns against 84 accepted (2026-07-17 → 2026-08-12),
because at Stop time the transcript tail is normally a turn still in flight.

Everything else (env-or-config identity that is never derived from the host,
visible degradation, always-exit-0) follows the shared pattern.

Always shadow-enqueues locally. In verified delivery_mode it also stages the event
and runs ONE bounded shared-drainer pass (never a direct Musubi POST); in the default
shadow mode nothing leaves the disk. Every failure degrades visibly and exits 0 — this
hook never breaks the session.
"""

from __future__ import annotations

import json
import re
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

from musubi_claude_exchange import (
    ExchangeError,
    exchange_for,
    exchange_id,
    exchange_metadata,
    input_fields,
    iter_dicts,
    resolve_anchor,
)
from musubi_claude_pending import Candidate, expired, load_all, remove, save
from musubi_claude_runtime import (
    RuntimeConfig,
    RuntimeConfigError,
    data_root,
    harness_bin,
    memory_data_bin,
    plugin_config,
    local_tool_environment,
    runtime_config,
    tool_environment,
)


class AdapterError(ValueError):
    """A Claude transcript turn could not be safely projected to an envelope."""


try:
    from musubi_transcript_jsonl import Corrupt as _Corrupt, iter_records as _iter_records
except ModuleNotFoundError as _exc:  # pragma: no cover - exercised by tests
    if _exc.name != "musubi_transcript_jsonl":
        raise
    _Corrupt = None
    _iter_records = None


class _SkipMarker:
    """Fallback sentinel mirroring the helper's Corrupt contract."""

    __slots__ = ("lineno", "reason")

    def __init__(self, lineno: int, reason: str) -> None:
        self.lineno, self.reason = lineno, reason


def _records(lines: list[str]):
    """Reassembling reader when available; otherwise today's skip semantics."""
    if _iter_records is not None:
        return _iter_records(lines)
    return _skip_only(lines)


def _skip_only(lines: list[str]):
    for idx, line in enumerate(lines, 1):
        line = line.strip()
        if not line:
            continue
        try:
            record = json.loads(line)
        except json.JSONDecodeError:
            # Harmless here: a record we cannot read simply cannot match an id. Unlike
            # positional parsing, skipping it can never bind output to a prior prompt.
            yield _SkipMarker(idx, "unparseable")
            continue
        # VALID JSON that is not an object -- `123`, `"str"`, `[]`, `null`. json.loads
        # succeeds, so the decode guard above never sees it, and a record classifier would
        # call .get() on an int and raise AttributeError. main() does not catch that,
        # so the hook would DIE rather than decline, breaking the session it promises
        # never to block. A non-object cannot carry a promptId, so skipping is both
        # safe and complete.
        if isinstance(record, dict) and "type" in record:
            yield record
        else:
            yield _SkipMarker(idx, "not_a_record")


def _hook_str(hook: dict[str, Any], *names: str, error: str, conflict: str | None = None) -> str:
    """Read one non-empty string from `names`, requiring the aliases to AGREE.

    Taking the first alias that happened to be present would let a payload carrying both
    `prompt_id` and `promptId` with DIFFERENT values decide event identity by key order —
    the object would be stored under one id while the turn it describes belongs to another.
    Identical aliases are fine (a producer emitting both spellings); disagreement is not
    something to resolve by preference, so it fails closed.
    """
    found: list[str] = []
    for name in names:
        value = hook.get(name)
        if isinstance(value, str) and value.strip() and value not in found:
            found.append(value)
    if not found:
        raise AdapterError(error)
    if len(found) > 1:
        raise AdapterError(conflict or f"{error}_conflict")
    return found[0]


def _data_root() -> Path:
    return data_root()


def _plugin_config() -> dict[str, str]:
    try:
        return plugin_config()
    except RuntimeConfigError as exc:
        raise AdapterError(str(exc)) from exc


def _identity_config() -> tuple[str, str, str]:
    """actor / presence / zone are deployment configuration — NEVER derived from the host.

    Env-first-then-config, all-or-nothing identity, and namespace policy now live in the
    shared PluginRuntime, so the Claude and Codex seats cannot silently diverge.
    """
    try:
        configured = runtime_config()
    except RuntimeConfigError as exc:
        raise AdapterError(str(exc)) from exc
    return configured.actor, configured.presence, configured.zone


def candidate_from_hook(hook: dict[str, Any]) -> Candidate:
    """The Stop event's own facts: which session, which prompt, what I answered.

    The answer TEXT stays authoritative from the event, verbatim except the non-empty
    check. The transcript only supplies the anchor id and the input span, and only once
    the answer record is on disk (see musubi_claude_pending for the measured race).
    """
    transcript = _hook_str(hook, "transcript_path", error="hook_transcript_missing")
    session = _hook_str(hook, "session_id", error="hook_session_missing")
    prompt = _hook_str(hook, "prompt_id", "promptId", error="hook_prompt_id_missing", conflict="hook_prompt_id_conflict")
    answer = _hook_str(
        hook,
        "last_assistant_message",
        "lastAssistantMessage",
        error="hook_answer_missing",
        conflict="hook_answer_conflict",
    )
    return Candidate(
        session_id=session,
        prompt_id=prompt,
        transcript_path=str(Path(transcript).expanduser()),
        answer_text=answer,
        is_sidechain_hint=False,
        created_at=time.time(),
    )


def _load_records(transcript_path: str) -> list[dict[str, Any]]:
    try:
        lines = Path(transcript_path).read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        raise AdapterError("transcript_unreadable") from exc
    return iter_dicts(_records(lines))


def envelope_for(candidate: Candidate) -> dict[str, Any]:
    """Resolve one candidate to a 1.7 exchange envelope, or raise.

    ExchangeError("answer_not_in_transcript") means "not yet", and the caller keeps the
    candidate. Every other ExchangeError is definitive for this transcript.
    """
    records = _load_records(candidate.transcript_path)
    answer_id = resolve_anchor(records, candidate.prompt_id, candidate.answer_text)
    exchange = exchange_for(records, answer_id)
    # Bind to the Stop's own session: a stale transcript_path must not yield a healthy
    # record for a DIFFERENT session.
    if exchange.session_id != candidate.session_id:
        raise AdapterError("hook_session_transcript_mismatch")
    actor, presence, zone = _identity_config()
    envelope: dict[str, Any] = {
        "event_id": exchange_id(exchange.session_id, exchange.answer_id),
        "actor": actor,
        "presence": presence,
        "plane": "episodic",
        "context": "subagent" if exchange.is_sidechain else "primary",
        "source": "claude-code",
        "zone": zone,
        "assistant_text": candidate.answer_text,
        # captured_at is excluded from the harness's replay comparison, so the time a
        # deferred candidate finally resolves does not make a replay look divergent.
        "captured_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
        "metadata": exchange_metadata(exchange, candidate.prompt_id),
    }
    envelope.update(input_fields(exchange))
    return envelope


def _harness() -> str:
    try:
        return harness_bin()
    except RuntimeConfigError as exc:
        raise AdapterError(str(exc)) from exc


# One drain pass per turn delivers one row, so a backlog never shrinks (measured
# 2026-09-26: median delivery lag 66 minutes). musubi-harness >= 1.2.0 can deliver
# several rows per pass. The harness that runs is whatever binary is configured, not
# necessarily this venv's, so an older one that rejects the flags is retried once
# without them (see without_batch_flags).
# Budget 3 s: one row is up to 4 memory-data calls at --timeout 5 (20 s), so the
# drain's process timeout (24 s) covers a row started just before the budget
# ends, and stage (5 s) + drain stays inside the 30 s Stop hook timeout.
BATCH_DRAIN = ["--max", "5", "--budget-seconds", "3"]


def without_batch_flags(command: list[str]) -> list[str] | None:
    """The same drain without the batch flags, or None if it had none."""
    if not command[-len(BATCH_DRAIN) :] == BATCH_DRAIN:
        return None
    return command[: -len(BATCH_DRAIN)]


_REASON = re.compile(r"[A-Za-z_]{1,64}")  # codes, and exception class names from a batch error row


def stalled_reason(stdout: str) -> str | None:
    """The first reason a drain made no progress, as a short code, or None.

    The drain exits 0 when a row fails transiently (it is retried later), so a
    pass can deliver nothing while looking successful. Only a code-shaped reason
    is kept: degraded.jsonl never holds server text.
    """
    try:
        payload = json.loads(stdout)
    except (json.JSONDecodeError, TypeError):
        return None
    if not isinstance(payload, dict):
        return None
    rows = payload.get("results") or [payload.get("result")]
    for row in rows:
        if isinstance(row, dict) and row.get("state") not in ("verified", "idle", None):
            reason = row.get("reason")
            return reason if isinstance(reason, str) and _REASON.fullmatch(reason) else "unknown"
    return None


def delivery_commands(envelope: dict[str, Any], configured: RuntimeConfig) -> list[tuple[list[str], int, bool]]:
    """Shadow mode → no remote delivery. Verified mode → stage the just-enqueued event and
    run one bounded shared-drainer pass (up to several rows on harness >= 1.2.0). The drainer owns the durable receipt + exact
    readback; this adapter never POSTs Musubi directly and never treats a queued row as
    verified. Same wiring as the Codex seat — separate outbox, identical contract.

    Each entry is (argv, timeout, remote). ``remote`` says whether the command talks
    to Musubi and so receives the credentials; it is declared here, beside the
    command, rather than inferred from argv positions (Aoi's review)."""
    if configured.delivery_mode == "shadow":
        return []
    db = _data_root() / envelope["actor"] / envelope["zone"] / "shadow.db"
    harness = harness_bin(configured)
    memory_data = memory_data_bin(configured)
    owner = f"{envelope['actor']}-{envelope['zone']}-claude-stop"
    return [
        ([harness, "--db", str(db), "stage", "--event-id", envelope["event_id"]], 5, False),
        (
            [
                harness,
                "--db",
                str(db),
                "drain",
                "--once",
                "--owner",
                owner,
                "--memory-data-bin",
                memory_data,
                "--timeout",
                "5",
                *BATCH_DRAIN,
            ],
            24,
            True,
        ),
    ]


def _degraded_scope(hook: Any) -> dict[str, str]:
    """Best-effort seat + session for a degraded record. Never raises.

    degraded.jsonl is ONE file shared by every seat on the machine, and until now each
    record carried only {at, reason}. That instrument can say a turn was lost; it cannot
    say WHOSE. Recovering the 18-Aoi/10-Shiori split of the 2026-08-20 loss required
    going to the transcripts — the plane the instrument exists to save you from.
    (Shiori named this while reviewing the fix: "the instrument cannot name the victim.")

    Both fields are identifiers, not prose: `seat` is deployment configuration and
    `session_id` is an opaque uuid the transcript filename already exposes. Neither is
    conversation content, so the no-second-copy-of-the-conversation invariant that keeps
    stdout/stderr out of this sink is untouched. Every lookup is defensive: a diagnostic
    record must never be the reason a failure path fails.
    """
    scope: dict[str, str] = {}
    try:
        actor = runtime_config().actor
        if isinstance(actor, str) and actor:
            scope["seat"] = actor
    except Exception:  # noqa: BLE001 — identity may be exactly what is broken
        pass
    try:
        session = hook.get("session_id") or hook.get("sessionId")
        if isinstance(session, str) and session:
            scope["session_id"] = session
    except Exception:  # noqa: BLE001 — hook may be any shape, or not a dict at all
        pass
    return scope


def _record_degraded(reason: str, scope: dict[str, str] | None = None) -> None:
    root = _data_root()
    try:
        root.mkdir(parents=True, exist_ok=True, mode=0o700)
        record = {"at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"), "reason": reason}
        record.update(scope or {})
        with (root / "degraded.jsonl").open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(record, sort_keys=True) + "\n")
    except OSError:
        pass


# The answer lands a beat after Stop fires (musubi_claude_pending). The CURRENT Stop's
# candidate gets about a second of polling so the common case does not lag a turn; the
# pending file is the correctness guarantee, not the poll.
POLL_ATTEMPTS = 5
POLL_INTERVAL_SECONDS = 0.25
# Older candidates drain first, inside a bounded slice of the hook budget. The current
# candidate is always attempted after them, whatever the slice used.
DRAIN_BUDGET_SECONDS = 4.0
DRAIN_MAX_OLDER = 5
# Retryable: the answer is not on disk yet, the transcript is briefly unreadable, or
# local infrastructure (identity config, enqueue, stage) failed. The candidate stays
# pending until musubi_claude_pending's bounded expiry. Every other ExchangeError is a
# fact about the transcript that retrying cannot change, and declines by name at once.
NOT_YET = "answer_not_in_transcript"
DEFINITIVE_ADAPTER_REASONS = frozenset({"hook_session_transcript_mismatch"})


def _seat_root(configured: RuntimeConfig) -> Path:
    return _data_root() / configured.actor / configured.zone


def _enqueue(envelope: dict[str, Any], configured: RuntimeConfig) -> None:
    db = _seat_root(configured) / "shadow.db"
    result = subprocess.run(
        [_harness(), "--db", str(db), "enqueue"],
        input=json.dumps(envelope),
        text=True,
        capture_output=True,
        timeout=8,
        check=False,
        # A local outbox write: identity, but no Musubi credentials.
        env=local_tool_environment(configured),
    )
    if result.returncode != 0:
        # Stable code + exit status ONLY. The child's stdout/stderr can echo the
        # envelope it was handed, which is the turn's prose: user text and my answer.
        # degraded.jsonl is an unencrypted diagnostic sink read by tooling, so it must
        # never become a second, unmanaged copy of the conversation.
        raise AdapterError(f"shadow_enqueue_failed:exit={result.returncode}")


def _stage(envelope: dict[str, Any], configured: RuntimeConfig) -> None:
    """Verified mode: promote the event to pending delivery. Local and idempotent
    (a restage of the same event is inserted=False), so a crash between enqueue and
    stage is repaired by simply running the candidate again."""
    commands = delivery_commands(envelope, configured)
    if not commands:
        return
    command, timeout, _remote = commands[0]
    result = subprocess.run(
        command,
        text=True,
        capture_output=True,
        timeout=timeout,
        check=False,
        env=local_tool_environment(configured),
    )
    if result.returncode != 0:
        raise AdapterError(f"verified_delivery_failed:exit={result.returncode}")


def _drain_remote(envelope: dict[str, Any], configured: RuntimeConfig, hook: Any) -> None:
    """ONE bounded shared-drainer pass for everything staged. Only this talks to
    Musubi, so only this gets the credentials."""
    for command, timeout, remote in delivery_commands(envelope, configured)[1:]:
        env = tool_environment(configured) if remote else local_tool_environment(configured)
        result = subprocess.run(command, text=True, capture_output=True, timeout=timeout, check=False, env=env)
        fallback = without_batch_flags(command) if result.returncode == 2 else None
        if fallback is not None and "unrecognized arguments" in (result.stderr or ""):
            # An older harness binary: deliver one row, as it always did.
            result = subprocess.run(fallback, text=True, capture_output=True, timeout=timeout, check=False, env=env)
        if result.returncode != 0:
            # Same invariant as the enqueue path: exit code is diagnosis, output is content.
            raise AdapterError(f"verified_delivery_failed:exit={result.returncode}")
        if remote:
            stalled = stalled_reason(result.stdout)
            if stalled:
                # rc=0 with no progress used to be silent: a token without write
                # scope failed every pass while nothing was recorded (Aoi's canary).
                _record_degraded(f"delivery_stalled:{stalled}", _degraded_scope(hook))


RESOLVED, RETRY, DECLINED = "resolved", "retry", "declined"


def _process(path: Path, candidate: Candidate, configured: RuntimeConfig, scope: dict[str, str]) -> tuple[str, dict[str, Any] | None]:
    """One candidate, start to finish. The file is removed ONLY after enqueue AND
    stage succeed, so any interruption leaves it to run again (both are idempotent)."""
    try:
        envelope = envelope_for(candidate)
    except ExchangeError as exc:
        if str(exc) == NOT_YET:
            return RETRY, None
        _record_degraded(str(exc), scope)
        remove(path)
        return DECLINED, None
    except AdapterError as exc:
        if str(exc) in DEFINITIVE_ADAPTER_REASONS:
            _record_degraded(str(exc), scope)
            remove(path)
            return DECLINED, None
        # transcript_unreadable, identity config: may clear on its own. Say so, keep it.
        _record_degraded(f"pending_retry:{exc}", scope)
        return RETRY, None
    try:
        _enqueue(envelope, configured)
        _stage(envelope, configured)
    except (AdapterError, OSError, subprocess.SubprocessError) as exc:
        reason = str(exc) if isinstance(exc, AdapterError) else "adapter_runtime_failed"
        _record_degraded(f"pending_retry:{reason}", scope)
        return RETRY, None
    remove(path)
    return RESOLVED, envelope


def _retry(path: Path, candidate: Candidate, configured: RuntimeConfig, scope: dict[str, str]) -> None:
    candidate.attempts += 1
    if expired(candidate):
        _record_degraded("pending_expired", scope)
        remove(path)
    else:
        save(_seat_root(configured), candidate)


def drain(configured: RuntimeConfig, hook: Any, *, current_key: str | None = None) -> list[dict[str, Any]]:
    """Resolve pending candidates OLDEST FIRST, then the current Stop's (with its short
    poll). Each candidate is its own unit: a failure is recorded by name and the loop
    continues, so one bad candidate never blocks another or hides earlier successes."""
    captured: list[dict[str, Any]] = []
    entries = list(load_all(_seat_root(configured)))
    readable = [(p, c) for p, c in entries if c is not None]
    for path, candidate in entries:
        if candidate is None:
            _record_degraded("pending_unreadable", _degraded_scope(hook))
            remove(path)
    readable.sort(key=lambda item: item[1].created_at)
    older = [(p, c) for p, c in readable if c.key != current_key]
    current = [(p, c) for p, c in readable if c.key == current_key]
    deadline = time.monotonic() + DRAIN_BUDGET_SECONDS
    for index, (path, candidate) in enumerate(older):
        if index >= DRAIN_MAX_OLDER or time.monotonic() > deadline:
            break
        scope = {**_degraded_scope(hook), "session_id": candidate.session_id}
        outcome, envelope = _process(path, candidate, configured, scope)
        if outcome == RESOLVED and envelope is not None:
            captured.append(envelope)
        elif outcome == RETRY:
            _retry(path, candidate, configured, scope)
    for path, candidate in current:
        scope = {**_degraded_scope(hook), "session_id": candidate.session_id}
        for attempt in range(POLL_ATTEMPTS):
            outcome, envelope = _process(path, candidate, configured, scope)
            if outcome != RETRY:
                break
            if attempt + 1 < POLL_ATTEMPTS:
                time.sleep(POLL_INTERVAL_SECONDS)
        if outcome == RESOLVED and envelope is not None:
            captured.append(envelope)
        elif outcome == RETRY:
            _retry(path, candidate, configured, scope)
    return captured


def main(argv: list[str] | None = None) -> int:
    args = sys.argv[1:] if argv is None else argv
    # SessionStart / SessionEnd run with --drain-only: they resolve and stage locally
    # but leave the network pass to the next Stop, which has the budget for it.
    drain_only = "--drain-only" in args
    hook: Any = None
    try:
        raw = sys.stdin.read()
        try:
            hook = json.loads(raw) if raw.strip() else {}
        except json.JSONDecodeError:
            if not drain_only:
                raise
            hook = {}
        if not isinstance(hook, dict):
            raise AdapterError("hook_payload_invalid")
        configured = runtime_config()
        current_key = None
        if not drain_only:
            try:
                candidate = candidate_from_hook(hook)
                # Saved BEFORE any capture attempt: from here on, nothing that fails
                # (enqueue, stage, a killed hook) can lose this exchange.
                save(_seat_root(configured), candidate)
                current_key = candidate.key
            except AdapterError as exc:
                _record_degraded(str(exc), _degraded_scope(hook))
        captured = drain(configured, hook, current_key=current_key)
        if captured and not drain_only:
            _drain_remote(captured[-1], configured, hook)
    except (AdapterError, json.JSONDecodeError, OSError, subprocess.SubprocessError, RuntimeConfigError) as exc:
        reason = str(exc) if isinstance(exc, (AdapterError, RuntimeConfigError)) else "adapter_runtime_failed"
        _record_degraded(reason, _degraded_scope(hook))
    except Exception as exc:  # noqa: BLE001 — deliberate backstop, see below
        # The always-exit-0 promise cannot be carried by an ALLOWLIST of exception types:
        # that is precisely the shape that let an AttributeError kill Stop (QA blocker #2).
        # An unforeseen failure must still degrade rather than break the session.
        #
        # Only the exception CLASS is recorded. str(exc) routinely embeds the value that
        # caused it — a transcript fragment, a prompt, a path — and degraded.jsonl is a
        # diagnostic sink, not a place to spill conversation content.
        #
        # NOT BaseException: KeyboardInterrupt and SystemExit propagate, because a session
        # being interrupted or torn down is not a degraded capture and must not be recorded
        # as one. MemoryError DOES inherit Exception and IS caught here.
        _record_degraded(f"adapter_unexpected_error:{type(exc).__name__}", _degraded_scope(hook))
    print("{}")  # Stop hooks emit JSON; empty object = no directive, never blocks the turn
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
