#!/usr/bin/env python3
"""Read-only health report for musubi-claude, printed as one JSON object.

Backs the ``/musubi-claude:health`` skill. It answers "is my memory actually
working?" from local state only: which settings and state root are in use,
whether the identity resolves, what the capture and delivery outboxes hold, and
what degraded recently. It never prints conversation content or credentials,
never writes, and never calls the network unless ``--probe`` is given (then one
bounded provider status call through the same memory-data path the tools use).

It always exits 0 so the skill that embeds it never aborts; problems are data.
"""

from __future__ import annotations

import argparse
import json
import sqlite3
import subprocess
from collections import Counter
from pathlib import Path
from typing import Any

import musubi_claude_runtime as rt

DEGRADED_TAIL = 200
RECENT_REASONS = 5


def _outbox_counts(db: Path) -> dict[str, Any]:
    """Count capture dispositions and delivery states without creating anything."""
    if not db.is_file():
        return {"present": False}
    result: dict[str, Any] = {"present": True}
    try:
        with sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=2) as conn:
            tables = {row[0] for row in conn.execute("SELECT name FROM sqlite_master WHERE type='table'")}
            if "capture_events" in tables:
                result["capture"] = dict(conn.execute("SELECT disposition, COUNT(*) FROM capture_events GROUP BY disposition").fetchall())
            if "delivery_events" in tables:
                result["delivery"] = dict(conn.execute("SELECT state, COUNT(*) FROM delivery_events GROUP BY state").fetchall())
    except sqlite3.Error as exc:
        result["error"] = f"outbox_unreadable: {type(exc).__name__}"
    return result


def _event(db: Path, event_id: str) -> dict[str, Any]:
    """One delivery row's state and receipt id, never its content."""
    if not db.is_file():
        return {"event_id": event_id, "found": False}
    try:
        with sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=2) as conn:
            row = conn.execute("SELECT state, object_id, attempt_count FROM delivery_events WHERE event_id = ?", (event_id,)).fetchone()
    except sqlite3.Error as exc:
        return {"event_id": event_id, "error": f"outbox_unreadable: {type(exc).__name__}"}
    if row is None:
        return {"event_id": event_id, "found": False}
    state, object_id, attempts = row
    return {"event_id": event_id, "found": True, "state": state, "object_id": object_id, "attempts": attempts}


def _degraded(path: Path) -> dict[str, Any]:
    """Summarise the tail of a degraded.jsonl: reason counts and the latest time."""
    if not path.is_file():
        return {"present": False}
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError as exc:
        return {"present": True, "error": f"unreadable: {type(exc).__name__}"}
    reasons: Counter[str] = Counter()
    latest = None
    for line in lines[-DEGRADED_TAIL:]:
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(row, dict):
            continue
        reason = str(row.get("reason") or "unknown").split(":", 1)[0]
        reasons[reason] += 1
        at = row.get("at") or row.get("observed_at") or row.get("ts")
        if isinstance(at, str) and (latest is None or at > latest):
            latest = at
    return {
        "present": True,
        "lines_total": len(lines),
        "window": min(len(lines), DEGRADED_TAIL),
        "top_reasons": dict(reasons.most_common(RECENT_REASONS)),
        "latest_at": latest,
    }


def _undelivered(counts: dict[str, Any]) -> int:
    delivery = counts.get("delivery") or {}
    return int(sum(v for k, v in delivery.items() if k not in ("verified", "dead")))


def report(probe: bool, event_id: str | None = None) -> dict[str, Any]:
    out: dict[str, Any] = {
        "settings_source": rt.settings_source,
        "transport_source": rt.seat_transport_source,
        "state_root_source": rt.state_root_source,
    }
    root = rt.data_root()
    out["state_root"] = str(root)
    try:
        import importlib.metadata as md

        out["harness_version"] = md.version("musubi-harness")
    except Exception:  # noqa: BLE001 - version is informational
        out["harness_version"] = None

    try:
        config = rt.runtime_config()
    except rt.RuntimeConfigError as exc:
        out["identity"] = {"ok": False, "error": str(exc)}
        config = None
    else:
        out["identity"] = {
            "ok": True,
            "actor": config.actor,
            "presence": config.presence,
            "zone": config.zone,
            "delivery_mode": config.delivery_mode,
        }

    if config is not None:
        try:
            bin_path = rt.memory_data_bin(config)
            out["transport"] = {
                "ok": True,
                "kind": "bundled_http" if Path(bin_path).name == "musubi-memory-data" else "memory_data",
            }
        except rt.RuntimeConfigError as exc:
            bin_path = None
            out["transport"] = {"ok": False, "error": str(exc)}
        db = root / config.actor / config.zone / "shadow.db"
        out["outbox"] = _outbox_counts(db)
        if event_id:
            out["event"] = _event(db, event_id)
        if probe and bin_path:
            try:
                done = subprocess.run(
                    [bin_path, "--json", "--timeout", "5", "musubi", "status"],
                    capture_output=True,
                    text=True,
                    timeout=8,
                    check=False,
                    env=rt.tool_environment(config),
                )
                out["provider"] = {"reachable": done.returncode == 0}
                if done.returncode != 0:
                    out["provider"]["detail"] = (done.stderr or done.stdout).strip()[:200]
            except (OSError, subprocess.SubprocessError) as exc:
                out["provider"] = {"reachable": False, "detail": type(exc).__name__}

    out["degraded"] = {"state_root": _degraded(root / "degraded.jsonl")}

    # Both roots can hold an outbox (see resolve_state_root). Rows still pending
    # in the root that is NOT in use will never drain, so say so plainly.
    legacy = Path.home() / ".local" / "state" / rt.STATE_NAME
    if config is not None and legacy.resolve() != root.resolve():
        other = _outbox_counts(legacy / config.actor / config.zone / "shadow.db")
        if other.get("present"):
            out["other_root"] = {"path": str(legacy), "undelivered": _undelivered(other)}
        out["degraded"]["other_root"] = _degraded(legacy / "degraded.jsonl")
    return out


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--probe", action="store_true", help="also make one bounded provider status call")
    parser.add_argument("--event", help="report one delivery record's state by its exact event_id")
    # Arguments come from a user's free-text /musubi-claude:health line, and an
    # argparse exit would abort the skill. Accept "probe" without dashes and
    # report anything else instead of failing on it.
    args, extra = parser.parse_known_args(argv)
    if "probe" in extra:
        args.probe = True
        extra = [item for item in extra if item != "probe"]
    try:
        payload = report(args.probe, args.event)
    except Exception as exc:  # noqa: BLE001 - health must report, never abort the skill
        payload = {"error": f"health_failed: {type(exc).__name__}: {str(exc)[:200]}"}
    if extra:
        payload["ignored_args"] = extra[:10]
    print(json.dumps(payload, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
